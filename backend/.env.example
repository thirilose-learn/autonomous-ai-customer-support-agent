# Backend Server Configuration
PROJECT_NAME="Autonomous AI Customer Support & Resolution Agent"
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Supabase Infrastructure (PostgreSQL + pgvector)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres.your-project-id:your_password@aws-0-region.pooler.supabase.com:6543/postgres

# Local RAG & Vector Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RAG_SIMILARITY_THRESHOLD=0.65
RAG_TOP_K=3

# Customer Session & JWT Authentication
SESSION_SECRET_KEY=your_random_64_char_secret_key_here
SESSION_EXPIRE_MINUTES=1440

# LLM & Agent Configuration (Groq Cloud)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.1

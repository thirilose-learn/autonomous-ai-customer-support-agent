# Backend Server Configuration
PROJECT_NAME="Autonomous AI Customer Support & Resolution Agent"
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Supabase Infrastructure (Configured in Level 3)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Free Local RAG & Vector Embeddings (Level 4 - 100% Free & Open Source)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RAG_SIMILARITY_THRESHOLD=0.65
RAG_TOP_K=3

# Demo Customer Session & Authentication
SESSION_SECRET_KEY=
SESSION_EXPIRE_MINUTES=1440

# Free Hosted LLM & Agent Provider (Level 5 - Groq Cloud Free Developer Tier)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.1


